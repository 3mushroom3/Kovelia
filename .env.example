# Copy to .env.local and fill in. All integrations are optional in development.

# Public URL of the site (used for canonical URLs, sitemap, OpenGraph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Sanity CMS (without it the site serves local content from src/content/fallback.ts)
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_READ_TOKEN=
# Secret for the Sanity webhook -> POST /api/revalidate
SANITY_REVALIDATE_SECRET=

# --- Contact form delivery (at least one channel is required in production)
# Where leads are emailed
CONTACT_EMAIL_TO=kovelia@list.ru

# Email via SMTP (Mail.ru: create an app password in mailbox settings -> Security -> "Пароли для внешних приложений")
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USER=kovelia@list.ru
SMTP_PASS=

# Optional: Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: email via Resend instead of SMTP (requires a verified sending domain)
RESEND_API_KEY=
CONTACT_EMAIL_FROM=
